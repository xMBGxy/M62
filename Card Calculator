<!DOCTYPE html><html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Card Draw Probability Calculator</title>
  <style>
    body { font-family: Arial, sans-serif; padding: 20px; max-width: 600px; margin: auto; }
    h1 { text-align: center; }
    label { display: block; margin: 10px 0 5px; }
    input { width: 100%; padding: 8px; box-sizing: border-box; }
    button { margin-top: 15px; padding: 10px 20px; font-size: 16px; }
    #result { margin-top: 20px; font-weight: bold; }
  </style>
</head>
<body>
  <h1>Card Draw Probability Calculator</h1>
  <p>Calculate the probability of drawing at least 1 Card A and at least 1 Card B in a hand from your deck.</p>
  <form id="calcForm">
    <label for="deckSize">Deck Size (N):</label>
    <input type="number" id="deckSize" value="60" min="1" required />
    <label for="copiesA">Copies of Card A (K₁):</label>
    <input type="number" id="copiesA" value="4" min="0" required />
    <label for="copiesB">Copies of Card B (K₂):</label>
    <input type="number" id="copiesB" value="4" min="0" required />
    <label for="handSize">Hand Size (n):</label>
    <input type="number" id="handSize" value="7" min="1" required />
    <button type="submit">Calculate Probability</button>
  </form>
  <div id="result"></div>  <script>
    // Compute binomial coefficient nCk without overflow using multiplicative formula
    function nCk(n, k) {
      if (k < 0 || k > n) return 0;
      k = Math.min(k, n - k);
      let result = 1;
      for (let i = 1; i <= k; i++) {
        result = result * (n - k + i) / i;
      }
      return result;
    }

    document.getElementById('calcForm').addEventListener('submit', function(e) {
      e.preventDefault();
      const N = parseInt(document.getElementById('deckSize').value, 10);
      const K1 = parseInt(document.getElementById('copiesA').value, 10);
      const K2 = parseInt(document.getElementById('copiesB').value, 10);
      const n = parseInt(document.getElementById('handSize').value, 10);

      const totalComb = nCk(N, n);
      const p0A = nCk(N - K1, n) / totalComb;
      const p0B = nCk(N - K2, n) / totalComb;
      const p0AB = nCk(N - K1 - K2, n) / totalComb;
      const probability = 1 - p0A - p0B + p0AB;
      const pct = (probability * 100).toFixed(4);

      document.getElementById('result').textContent = `Probability: ${probability.toFixed(6)} (${pct}%)`;
    });
  </script>  <!-- To host on GitHub Pages: push this index.html to your repository's root and enable GitHub Pages in Settings --></body>
</html>
